@startuml

title NoteLy — ER-модель даних

entity "User" as User {

* id : UUID <<PK>>
  --
  email : VARCHAR <<персональні>>
  password_hash : VARCHAR <<чутливі>>
  name : VARCHAR <<персональні>>
  created_at : TIMESTAMP
  failed_login_attempts : INT
  locked_until : TIMESTAMP
  }

entity "sessions" as Session {

* id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  token_hash : TEXT <<чутливі, UNIQUE>>
  created_at : TIMESTAMPTZ
  last_seen_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ
  }

entity "unlock_tokens" as UnlockToken {

* token_hash : TEXT <<PK, чутливі>>
  --
  user_id : UUID <<FK>>
  expires_at : TIMESTAMPTZ
  }

entity "Document" as Document {

* id : UUID <<PK>>
  --
  owner_id : UUID <<FK>>
  title : VARCHAR
  access_mode : VARCHAR
  is_deleted : BOOLEAN
  deleted_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
  }

entity "idempotency_keys" as IdempotencyKey {

* user_id : UUID <<PK, частина>>
* key : TEXT <<PK, частина>>
  --
  requested_title : TEXT
  document_id : BIGINT <<FK>>
  created_at : TIMESTAMPTZ
  }

entity "Paragraph" as Paragraph {

* id : UUID <<PK>>
  --
  document_id : UUID <<FK>>
  position : INT
  content : TEXT <<чутливі>>
  }

entity "DocumentAccess" as DocumentAccess {

* id : UUID <<PK>>
  --
  document_id : UUID <<FK>>
  user_id : UUID <<FK>>
  role : VARCHAR
  created_at : TIMESTAMP
  }

entity "AccessRequest" as AccessRequest {

* id : UUID <<PK>>
  --
  document_id : BIGINT
  requester_id : UUID <<FK>>
  request_type : VARCHAR
  requested_role : VARCHAR <<nullable>>
  status : VARCHAR
  created_at : TIMESTAMP
  resolved_at : TIMESTAMP <<nullable>>
  }

entity "DocumentVersion" as DocumentVersion {

* id : UUID <<PK>>
  --
  document_id : UUID <<FK>>
  author_id : UUID <<FK>>
  content_snapshot : TEXT <<чутливі>>
  created_at : TIMESTAMP
  }

entity "CalendarEvent" as CalendarEvent {

* id : UUID <<PK>>
  --
  creator_id : UUID <<FK>>
  document_id : UUID <<FK>>
  title : VARCHAR
  start_time : TIMESTAMP
  end_time : TIMESTAMP
  created_at : TIMESTAMP
  }

entity "EventParticipant" as EventParticipant {

* id : UUID <<PK>>
  --
  event_id : UUID <<FK>>
  user_id : UUID <<FK>>
  created_at : TIMESTAMP
  }

User ||--o{ Document : owns
User ||--o{ Session : authenticates
User ||--o{ UnlockToken : unlocks
Document ||--o| IdempotencyKey : created by
Document ||--o{ Paragraph : contains
User ||--o{ DocumentAccess : has
Document ||--o{ DocumentAccess : grants

User ||--o{ AccessRequest : creates
Document ||--o{ AccessRequest : receives

User ||--o{ DocumentVersion : creates
Document ||--o{ DocumentVersion : contains

User ||--o{ CalendarEvent : creates
Document |o--o{ CalendarEvent : linked to

CalendarEvent ||--o{ EventParticipant : contains
User ||--o{ EventParticipant : participates

@enduml
