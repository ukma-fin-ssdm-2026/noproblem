@startuml 
title NoteLy — діаграма розгортання та межі довіри

skinparam shadowing false
skinparam node {
  BackgroundColor white
  BorderColor #555555
}
skinparam node<<TrustBoundary>> {
  BorderColor #C0392B
  BorderStyle dashed
  BorderThickness 2
}

legend right
  |= Позначення |= Значення |
  | Червона пунктирна рамка | Межа зони довіри |
  | Червона пунктирна стрілка | Перетин межі довіри |
  | TB1 | Пристрій користувача ↔ сервер NoteLy |
  | TB2 | Довірена зона сервера NoteLy |
  | TB3 | Сервер NoteLy ↔ сервер бази даних |
  | TB4 | Сервер NoteLy ↔ зовнішній Email Service |
endlegend

node "TB1 — Недовірена зона користувача" as UserZone {
  node "Пристрій користувача" as UserDevice {
    node "Веб-браузер" as Browser {
      artifact "Вебклієнт NoteLy\n(редактор, буфер змін)" as WebClient
    }
  }
}

node "TB2 — Довірена зона NoteLy" as ServerZone {
  node "Серверне середовище NoteLy" as AppServer {
    artifact "Застосунок NoteLy\nGateway, REST API, Collab, IAM,\nDocs, Search, Calendar, Scheduler" as App
  }
}

node "TB3 — Зона даних" as DataZone {
  node "Сервер бази даних" as DatabaseServer {
    database "PostgreSQL\n(сховище даних)" as DB
  }
}

node "TB4 — Зовнішня зона" as ExternalZone {
  cloud "Email Service\n(SMTP submission)" as Mail
}

WebClient -[#C0392B,dashed]-> AppServer : <b>TB1</b>\nHTTPS / WSS, TCP 443
AppServer -[#C0392B,dashed]-> DatabaseServer : <b>TB3</b>\nPostgreSQL, TCP 5432
AppServer -[#C0392B,dashed]-> Mail : <b>TB4</b> (виклик IAM)\nSMTP submission, TCP 587,\nSTARTTLS

@enduml

