@startuml
title NoteLy — діаграма розгортання

skinparam shadowing false
skinparam componentStyle rectangle

node "Пристрій користувача" {
  node "Веб-браузер" {
    component "Вебклієнт NoteLy\n(редактор, буфер змін)" as Web
  }
}

node "Сервер"{
  node "Серверне середовище виконання" {
    component "Шлюз" as GW
    component "REST API" as API
    component "Спільне редагування\n(WebSocket)" as Collab
    component "Ідентичність і доступ" as IAM
    component "Документи, абзаци та версії" as Docs
    component "Пошук документів" as Search
    component "Календар і події" as Calendar
    component "Планувальник\nочищення кошика" as Scheduler
  }
}

node "База даних" {
  database "Сховище даних" as DB
}

cloud "Email Service\n(SMTP/API)" as Mail

Web --> GW : HTTPS / WSS
GW --> API : REST
GW --> Collab : WSS
GW --> IAM : перевірка токена

API --> IAM
API --> Docs
API --> Search
API --> Calendar
Collab --> IAM
Collab --> Docs
Docs --> IAM
Search --> IAM
Calendar --> IAM
Scheduler --> Docs

Docs --> DB : SQL (TCP)
IAM --> DB : SQL (TCP)
Search --> DB : SQL (TCP)
Calendar --> DB : SQL (TCP)

IAM --> Mail : SMTP / API\n(запрошення, розблокування)

@enduml

