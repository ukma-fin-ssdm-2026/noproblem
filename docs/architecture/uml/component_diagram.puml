@startuml
title NoteLy — компонентна діаграма

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

rectangle "NoteLy" {
  component "Вебклієнт\nредактор, буфер змін,\nповтор збереження" as Web

  package "Backend" {
    component "Шлюз\nтокен, ліміти запитів" as GW
    component "REST API\nHTTP/JSON" as API
    component "Спільне редагування\nWebSocket" as Collab
    component "Ідентичність і доступ\nреєстрація, вхід, сесії,\nролі, запрошення" as IAM
    component "Документи та версії\nназви, кошик, історія" as Docs
    component "Пошук документів" as Search
    component "Календар і події" as Calendar
    component "Планувальник\nочищення кошика" as Scheduler
  }

  database "Сховище даних" as DB
}

cloud "Email Service\n(SMTP/API)" as Mail

' --- вхід у систему ---
Web --> GW : HTTPS / WSS\nвхід і реєстрація без токена,\nрешта з токеном або квитком
GW --> IAM : перевірка токена → користувач
GW --> API : REST
GW --> Collab : WSS

' --- REST ---
API --> IAM : реєстрація, вхід,\nвихід, керування доступом
API --> Docs : «мої документи»,\nкошик, версії
API --> Search : пошук
API --> Calendar : події

' --- WebSocket ---
Collab --> IAM : роль у документі,\nперевірка з'єднань щосекунди
Collab --> Docs : стан, автозбереження ≤ 5 с,\nзнімки версій

' --- роль у документі: єдине джерело - IAM ---
Docs --> IAM : ролі користувача\nу документах
Search --> IAM : ACL-фільтр
Calendar --> IAM : доступ до документа,\nучасник за email

' --- дані ---
Docs --> DB : документи, абзаци, версії
IAM --> DB : акаунти, сесії, ролі
Search --> DB : пошук без кошика
Calendar --> DB : події

' --- фон і пошта ---
Scheduler --> Docs : видалення з кошика після 30 днів
IAM --> Mail : запрошення,\nрозблокування

note bottom of GW
  Лише автентифікація та ліміти за IP.
  Публічні маршрути: реєстрація, вхід,
  посилання-запрошення. Роль у документі
  шлюз не перевіряє.
end note

note bottom of IAM
  Єдине джерело правди про ролі:
  запис (користувач, документ, Owner/Editor/Guest).
  «За посиланням»: при першому відкритті
  записує Guest явно.
end note

note bottom of DB
  Остаточне видалення документа каскадно
  прибирає версії, доступи, прив'язки в календарі.
end note

note bottom of Collab
  Lock Manager (частина Collab):
  блокування абзаців лише в пам'яті
  серверного процесу.
  Один абзац — один редактор одночасно.
  Гість блокувань не створює.
end note
@enduml

